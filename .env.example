# Frontend: copy to frontend/.env.local when overriding the API URL
VITE_API_BASE_URL=http://localhost:8000

# Backend — all values are examples; never put real secrets in this file.
SKILLSCOPE_ENV=development
# Student-data routes fail closed in production until authentication, per-profile authorization, and verified consent exist.
# Relative SQLite paths are resolved from the SkillScope project root.
SKILLSCOPE_DATABASE_URL=sqlite:///./data/skillscope.db
# Synthetic profile and challenge fixture auto-seeds in development unless disabled.
# Production must set SKILLSCOPE_SEED_DEMO=false; never seed real student records.
SKILLSCOPE_SEED_DEMO=true
# Fresh source download cache TTL. 86400 = one day; 0 disables cache reuse.
SKILLSCOPE_SOURCE_CACHE_TTL_SECONDS=86400
# Production CORS must list only explicit trusted HTTPS origins; do not use wildcard origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
